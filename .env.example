# Gemini API key used for both script generation and provisional TTS (v0.1).
GEMINI_API_KEY=

# Models (defaults shown; override if needed).
GEMINI_SCRIPT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# SQLite database file path.
LIFE_LESSON_DB_PATH=data/life_lesson.db

# Local folder of pre-curated 16:9 background loop videos.
BACKGROUND_VIDEO_DIR=assets/backgrounds

# Where generated audio/video output files are written.
OUTPUT_DIR=output

# Path to the ffmpeg executable (or just "ffmpeg" if it's on PATH).
FFMPEG_BINARY=ffmpeg

LOG_LEVEL=INFO

# Thai-capable bold font (.ttf/.otf) for thumbnails and chapter cards. Optional:
# common Linux Thai fonts (tlwg/Loma, Noto Sans Thai, Sarabun) are auto-detected.
THAI_FONT_PATH=

# Optional folder of ambient music beds (.mp3/.wav) mixed under the narration.
MUSIC_DIR=assets/music

# Optional text file, one credit line per line (stock video/music licenses),
# appended to every episode description.
CREDITS_FILE=assets/credits.txt

# Prefix each narration block with a delivery directive from its mood
# ("Say in a hushed voice: ..."). Set to 0 if your TTS model reads the
# directive aloud -- always listen to a sample before publishing.
TTS_STYLE_DIRECTIVES=1

# Channel shown in every description and at the end of every Short.
CHANNEL_HANDLE=@SakidJai_สะกิดใจ
CHANNEL_URL=https://www.youtube.com/@SakidJai_%E0%B8%AA%E0%B8%B0%E0%B8%81%E0%B8%B4%E0%B8%94%E0%B9%83%E0%B8%88

# Where `library export` copies MP4s for upload/download.
EXPORT_DIR=output/export

# illustrated = free, offline flat-style scenes drawn from each chapter's setting,
#               mood and characters (no video files needed).
# stock       = use your own looping clips in BACKGROUND_VIDEO_DIR.
VISUAL_MODE=illustrated
