# Gemini API key used for both script generation and provisional TTS (v0.1).
GEMINI_API_KEY=

# Models (defaults shown; override if needed).
GEMINI_SCRIPT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# SQLite database file path.
LIFE_LESSON_DB_PATH=data/life_lesson.db

# Local folder of pre-curated 16:9 background loop videos.
BACKGROUND_VIDEO_DIR=assets/backgrounds

# Where generated audio/video output files are written.
OUTPUT_DIR=output

# Path to the ffmpeg executable (or just "ffmpeg" if it's on PATH).
FFMPEG_BINARY=ffmpeg

LOG_LEVEL=INFO
